{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://jaldrishti.onrender.com/health"
    },
    {
      "source": "/analyze",
      "destination": "https://jaldrishti.onrender.com/analyze"
    },
    {
      "source": "/engineering",
      "destination": "https://jaldrishti.onrender.com/engineering"
    },
    {
      "source": "/material-compatibility",
      "destination": "https://jaldrishti.onrender.com/material-compatibility"
    },
    {
      "source": "/restore",
      "destination": "https://jaldrishti.onrender.com/restore"
    },
    {
      "source": "/knowledge/:path*",
      "destination": "https://jaldrishti.onrender.com/knowledge/:path*"
    },
    {
      "source": "/vision/:path*",
      "destination": "https://jaldrishti.onrender.com/vision/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://jaldrishti.onrender.com/images/:path*"
    },
    {
      "source": "/inspections/:path*",
      "destination": "https://jaldrishti.onrender.com/inspections/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://jaldrishti.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/|samples/|favicon\\.ico|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
