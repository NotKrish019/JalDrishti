# ============================================================
# Jaldrishti Environment Configuration Example
# Copy this file to .env for local development
# NEVER commit real credentials or .env to version control
# ============================================================

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Machine Learning & Vision Pipeline Paths
MODEL_PATH=vision/model/best.pt
DATASET_PATH=data/raw/

# Sovereign AI / Local Inference Configuration
# Local-first / India-first AI architecture (e.g. local LLM or Param/BharatGen when evaluated)
LLM_PROVIDER=local
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# Cloudinary Storage Configuration (Backend Only - NEVER expose to frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=jaldrishti/inspections
CLOUDINARY_SECURE_DELIVERY=true

# Image Upload & Processing Policies
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_IMAGE_FORMATS=jpeg,jpg,png,webp

# Metadata Persistence (SQLite)
SQLITE_DB_PATH=data/jaldrishti.db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

